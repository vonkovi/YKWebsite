---
// Sticky nav: wordmark + tabs (left), social + résumé icons (right).
// `subnav` variant (detail pages) swaps the tabs for a back-link to the index.
interface Props {
  variant?: 'main' | 'subnav';
  backHref?: string;
  backLabel?: string;
}
const { variant = 'main', backHref = '/#writing', backLabel = 'Writing' } = Astro.props;
const subnav = variant === 'subnav';
---
<header class:list={['nav', subnav && 'subnav']}>
  <nav class="nav-inner">
    <div class="nav-left">
      <a class="brand" href={subnav ? '/' : '#top'}>Yvon&nbsp;Kim</a>
      {subnav ? (
        <a class="back-link" href={backHref}><span class="arr" aria-hidden="true">←</span> {backLabel}</a>
      ) : (
        <>
          <button class="tab" data-tab="projects" aria-selected="true">Projects</button>
          <button class="tab" data-tab="writing" aria-selected="false">Writing</button>
        </>
      )}
    </div>
    <div class="nav-right">
      <div class="nav-social">
        <a href="mailto:kmyn7up@gmail.com" aria-label="Email" title="Email">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="1.5" y="3" width="13" height="10" rx="1.5"/><path d="M2 4l6 4.5L14 4"/></svg>
        </a>
        <a href="https://github.com/vonkovi" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/yvonkim" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 16 16" fill="currentColor"><path d="M13.6 0H2.4A2.4 2.4 0 000 2.4v11.2A2.4 2.4 0 002.4 16h11.2a2.4 2.4 0 002.4-2.4V2.4A2.4 2.4 0 0013.6 0zM4.8 13.3H2.7V6.4h2.1v6.9zM3.7 5.5a1.2 1.2 0 110-2.4 1.2 1.2 0 010 2.4zm9.6 7.8h-2.1V9.9c0-.85-.02-1.95-1.19-1.95-1.19 0-1.37.93-1.37 1.89v3.46H6.6V6.4h2v.94h.03c.28-.53.96-1.09 1.98-1.09 2.12 0 2.51 1.4 2.51 3.21v3.84z"/></svg>
        </a>
        <span class="nav-div" aria-hidden="true"></span>
        <a class="resume-link" href="/Yvon-Kim-Resume.pdf" download aria-label="Download résumé (PDF)" title="Résumé (PDF)">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 1.6H3.8a1.1 1.1 0 00-1.1 1.1v10.6a1.1 1.1 0 001.1 1.1h8.4a1.1 1.1 0 001.1-1.1V6.1L9 1.6z"/><path d="M8.9 1.7V6h4.3"/><path d="M5.2 9h5.6M5.2 11.4h3.9"/></svg>
        </a>
      </div>
    </div>
  </nav>
</header>
