---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// One case-study page per project. The MDX body renders into the prose column.
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, category, description, lede, year, stack, source, image } = project.data;
const { Content } = await render(project);
---

<BaseLayout
  title={`${title} — Yvon Kim`}
  description={`${title} — ${description}`}
>
  <Header variant="subnav" backHref="/#projects" backLabel="Work" />

  <main class="detail">
    <div class="wrap">

      <header class="detail-head">
        <p class="detail-cat">{category}</p>
        <h1>{title}</h1>
        <p class="detail-lede">{lede ?? description}</p>

        <div class="detail-meta">
          {year && (
            <div class="m"><span class="k">Year</span><span class="v">{year}</span></div>
          )}
          {stack && stack.length > 0 && (
            <div class="m"><span class="k">Stack</span><span class="v">{stack.join(' · ')}</span></div>
          )}
          {source && (
            <a class="source-btn" href={source} target="_blank" rel="noopener">
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
              View source
            </a>
          )}
        </div>
      </header>

      <div class="detail-hero">
        {image ? (
          <img src={image} alt={title} />
        ) : (
          <div class="hero-empty"><span class="placeholder">{title}</span></div>
        )}
      </div>

      <div class="detail-body">
        <article class="prose">
          <Content />
        </article>

        <div class="detail-foot">
          <a class="back-link" href="/#projects"><span class="arr" aria-hidden="true">←</span> All work</a>
          {source && (
            <a class="source-btn" href={source} target="_blank" rel="noopener">
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
              View source
            </a>
          )}
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
